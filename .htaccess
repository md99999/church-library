# Church Library plugin hardening (Apache). Every PHP file in this plugin is
# loaded by WordPress, never requested directly, so direct requests are denied.
# nginx ignores this file; see README.md for the equivalent nginx rules.
Options -Indexes

# Hidden files and folders anywhere below this folder (.git, .github, .env ...),
# which a copy made from a git clone brings with it. FilesMatch only sees the
# file name, so a file such as .git/HEAD or .git/config needs a path rule.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule (^|/)\. - [F,L]
</IfModule>
<IfModule !mod_rewrite.c>
	<IfModule mod_alias.c>
		RedirectMatch 403 /\.
	</IfModule>
</IfModule>

<FilesMatch "\.(?i:php\d?|phtml|phar|inc|sql|md|txt|log|json|lock|xml|yml|yaml|dist|sh|ini|bak|orig|swp|env|zip|gz|tar)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

<FilesMatch "^\.">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

<IfModule mod_headers.c>
	Header set X-Content-Type-Options nosniff
</IfModule>
