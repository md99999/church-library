# Keep Unix line endings, the norm for PHP and WordPress code.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.zip binary

# Development-only files, left out of `git archive` (and GitHub release source
# zips) so a built zip holds just the plugin. See README "Building the install zip".
/.gitattributes export-ignore
/.gitignore     export-ignore
/.github        export-ignore
/tools          export-ignore
