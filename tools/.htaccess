# Church Library: development tools (build scripts). They run from the command
# line only and are not part of a release zip, so deny every web request.
Options -Indexes -ExecCGI
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
